{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/stealth/ox-alpha",
  "provider": {
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    }
  },
  "permission": {
    "edit": "allow",
    "read": "allow",
    "bash": {
      "git *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "Get-*": "allow",
      "Test-*": "allow",
      "$env*": "allow",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "*": "ask"
    },
    "external_directory": "deny"
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "venv/**",
      ".git/**",
      "dist/**",
      "*.log",
      ".env"
    ]
  },
  "models": {
    "openrouter/stealth/ox-alpha": {
      "context": 950000,
      "output": 131072
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 50000
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "godot": {
      "command": "npx",
      "args": ["@coding-solo/godot-mcp"],
      "env": {
        "GODOT_PATH": "C:\\Users\\mayha\\Documents\\Godot\\Godot_v4.6.1-stable_win64_console.exe",
        "DEBUG": "true"
      },
      "enabled": true
    }
  }
}
